<Application
    x:Class="AgentTimeline.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Generated from design/design-tokens.json — see Themes/Tokens.xaml header -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Codename chip (代号 chip): small pill button, token colors/radius/padding -->
            <Style x:Key="CodenameChipStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CodenameChipBgBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CodenameChipTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeChip}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
            </Style>

            <!-- Frameless icon button used in the panel header -->
            <!--
                头部图标按钮。命中区**给死尺寸**而不是靠 Padding 撑：
                12px 字形 + Padding=4 实测只有 20×20dip，mac 因"太难点"已把同类按钮放大到
                21×26pt，Windows 竖向反而比它小 23%。这里对齐到 22×26。

                为什么不改 Padding：Padding 撑出来的尺寸随字形大小漂，换个 Glyph 就变；
                给死 Width/Height 才是稳定的命中框（mac 用的也是"固定 frame + contentShape"，
                不是 padding 正负抵消）。

                不影响版面：头部行高由**带文字的过滤按钮**决定（实测 27dip），26 仍在其下，
                所以 HeaderBar 高度、折叠高度、三张 README 一览图都不动。
                背景是 Transparent，静止态零视觉变化，变大的只有 hover 高亮与命中范围。
            -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
