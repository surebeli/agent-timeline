<Application
    x:Class="AgentTimeline.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Generated from design/design-tokens.json — see Themes/Tokens.xaml header -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Codename chip (代号 chip): small pill button, token colors/radius/padding -->
            <Style x:Key="CodenameChipStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CodenameChipBgBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CodenameChipTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeChip}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
            </Style>

            <!-- Frameless icon button used in the panel header -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
