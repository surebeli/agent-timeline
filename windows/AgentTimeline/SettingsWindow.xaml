<Window
    x:Class="AgentTimeline.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Standard-chrome window (PRD F6 设置界面); values load/save in code-behind. -->
    <ScrollViewer Padding="20,12,20,12" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" Spacing="16">

            <!-- ═══════════ 摘要引擎 ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="摘要引擎" />
            <RadioButtons x:Name="EngineRadios" SelectionChanged="EngineRadios_SelectionChanged">
                <RadioButton Content="本机 CLI（默认，零配置：claude -p / codex exec）" />
                <RadioButton Content="自定义 Provider（OpenAI 兼容接口）" />
                <RadioButton Content="纯规则（不调用 LLM）" />
            </RadioButtons>

            <ComboBox
                x:Name="CliCommandBox"
                MinWidth="180"
                Header="CLI 选择（auto 时优先 claude，其次 codex）">
                <ComboBoxItem Content="auto" />
                <ComboBoxItem Content="claude" />
                <ComboBoxItem Content="codex" />
            </ComboBox>

            <StackPanel x:Name="ProviderPanel" Spacing="8">
                <TextBox x:Name="ProviderBaseUrlBox" Header="Base URL" PlaceholderText="https://api.example.com/v1" />
                <PasswordBox x:Name="ProviderApiKeyBox" Header="API Key" />
                <TextBox x:Name="ProviderModelBox" Header="Model" PlaceholderText="gpt-4o-mini" />
            </StackPanel>

            <!-- ═══════════ 外观与窗口 ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="外观与窗口" />
            <Slider
                x:Name="HoverOpacitySlider"
                Header="悬停不透明度"
                Maximum="1.0"
                Minimum="0.3"
                StepFrequency="0.05" />
            <Slider
                x:Name="IdleOpacitySlider"
                Header="失焦不透明度"
                Maximum="1.0"
                Minimum="0.05"
                StepFrequency="0.05" />
            <ToggleSwitch x:Name="AlwaysOnTopToggle" Header="总在最前" OffContent="关" OnContent="开" />

            <!-- ═══════════ 数据与 Agent ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据与 Agent" />
            <NumberBox
                x:Name="BackfillDaysBox"
                Header="回填最近 N 天的 session"
                Maximum="90"
                Minimum="0"
                SpinButtonPlacementMode="Inline" />
            <StackPanel Spacing="4">
                <CheckBox x:Name="EnableClaudeCheck" Content="Claude Code" ToolTipService.ToolTip="%USERPROFILE%\.claude\projects" />
                <CheckBox x:Name="EnableCodexCheck" Content="Codex" ToolTipService.ToolTip="%USERPROFILE%\.codex\sessions" />
                <CheckBox x:Name="EnableGrokCheck" Content="Grok Build" ToolTipService.ToolTip="%USERPROFILE%\.grok\sessions" />
                <CheckBox x:Name="EnableKimiCheck" Content="Kimi Code" ToolTipService.ToolTip="%USERPROFILE%\.kimi-code\sessions" />
                <CheckBox x:Name="EnableZcodeCheck" Content="ZCode" ToolTipService.ToolTip="%USERPROFILE%\.zcode\cli\agents" />
            </StackPanel>
            <TextBlock
                FontSize="12"
                Opacity="0.6"
                Text="Agent 目录开关需重启应用后生效；其余设置保存即生效。"
                TextWrapping="Wrap" />

            <!-- ═══════════ actions ═══════════ -->
            <StackPanel
                Margin="0,4,0,8"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Cancel_Click" Content="取消" />
                <Button
                    Click="Save_Click"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
