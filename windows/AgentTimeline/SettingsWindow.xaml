<Window
    x:Class="AgentTimeline.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Standard-chrome window (PRD F6 设置界面); values load/save in code-behind. -->
    <ScrollViewer Padding="20,12,20,12" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" Spacing="16">

            <!-- ═══════════ 摘要引擎 ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="摘要引擎" />
            <RadioButtons x:Name="EngineRadios" SelectionChanged="EngineRadios_SelectionChanged">
                <RadioButton Content="本机 CLI（默认，零配置：claude -p / codex exec）" />
                <RadioButton Content="自定义 Provider（OpenAI 兼容接口）" />
                <RadioButton Content="纯规则（不调用 LLM）" />
            </RadioButtons>

            <StackPanel x:Name="CliPanel" Spacing="8">
                <TextBlock Opacity="0.7" Text="CLI 选择（auto 时优先 claude，其次 codex）" />
                <ComboBox x:Name="CliCommandBox" MinWidth="180">
                    <ComboBoxItem Content="auto" />
                    <ComboBoxItem Content="claude" />
                    <ComboBoxItem Content="codex" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="ProviderPanel" Spacing="8">
                <TextBox x:Name="ProviderBaseUrlBox" Header="Base URL" PlaceholderText="https://api.example.com/v1" />
                <PasswordBox x:Name="ProviderApiKeyBox" Header="API Key" />
                <TextBox x:Name="ProviderModelBox" Header="Model" PlaceholderText="gpt-4o-mini" />
            </StackPanel>

            <!-- ═══════════ 外观与窗口 ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="外观与窗口" />
            <Slider
                x:Name="HoverOpacitySlider"
                Header="悬停不透明度"
                Maximum="1.0"
                Minimum="0.3"
                StepFrequency="0.05" />
            <Slider
                x:Name="IdleOpacitySlider"
                Header="失焦不透明度"
                Maximum="1.0"
                Minimum="0.05"
                StepFrequency="0.05" />
            <ToggleSwitch x:Name="AlwaysOnTopToggle" Header="总在最前" OffContent="关" OnContent="开" />

            <!-- ═══════════ 数据与 Agent ═══════════ -->
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据与 Agent" />
            <NumberBox
                x:Name="BackfillDaysBox"
                Header="回填最近 N 天的 session"
                Maximum="90"
                Minimum="0"
                SpinButtonPlacementMode="Inline" />
            <StackPanel Spacing="4">
                <CheckBox x:Name="EnableClaudeCheck" Content="Claude Code（~\.claude\projects）" />
                <CheckBox x:Name="EnableCodexCheck" Content="Codex（~\.codex\sessions）" />
                <CheckBox x:Name="EnableKimiCheck" Content="Kimi（~\.kimi\sessions）" />
                <CheckBox x:Name="EnableZcodeCheck" Content="zcode（预留适配器，需指定 session 目录）" />
            </StackPanel>
            <TextBox
                x:Name="ZcodeRootBox"
                Header="zcode session 根目录"
                PlaceholderText="C:\Users\me\.zcode\sessions" />

            <TextBlock Opacity="0.6" TextWrapping="Wrap">
                提示：摘要引擎与外观改动即时生效；Agent 目录开关在重启应用后生效。
                摘要结果缓存在本地 SQLite（%LOCALAPPDATA%\AgentTimeline），同一命令不会重复调用 LLM。
            </TextBlock>

            <!-- ═══════════ actions ═══════════ -->
            <StackPanel
                Margin="0,4,0,8"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Cancel_Click" Content="取消" />
                <Button
                    Click="Save_Click"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
