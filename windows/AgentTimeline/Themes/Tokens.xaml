<!--
  Tokens.xaml — GENERATED from design/design-tokens.json (repo root, the single source
  of truth for both platforms). Regenerate by hand when the JSON changes.

  NOTE: the token file writes colors as #RRGGBB / #RRGGBBAA (alpha LAST); XAML wants
  #AARRGGBB, so alpha has been moved to the front here. E.g. cardBackground.light
  "#FFFFFFB8" → "#B8FFFFFF".
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#FF4F6BF0</Color>
            <Color x:Key="TextPrimaryColor">#FF1D2129</Color>
            <Color x:Key="TextSecondaryColor">#FF4E5969</Color>
            <Color x:Key="TextTertiaryColor">#FF86909C</Color>
            <Color x:Key="CardBackgroundColor">#B8FFFFFF</Color>
            <Color x:Key="CardBorderColor">#14000000</Color>
            <Color x:Key="TimelineRailColor">#FFC9CDD4</Color>
            <Color x:Key="CodenameChipBgColor">#1F4F6BF0</Color>
            <Color x:Key="CodenameChipTextColor">#FF3A50C2</Color>
            <Color x:Key="ResultLineColor">#FF0FA968</Color>
            <Color x:Key="StatusChangedColor">#FFC77414</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="TimelineRailBrush" Color="{StaticResource TimelineRailColor}" />
            <SolidColorBrush x:Key="CodenameChipBgBrush" Color="{StaticResource CodenameChipBgColor}" />
            <SolidColorBrush x:Key="CodenameChipTextBrush" Color="{StaticResource CodenameChipTextColor}" />
            <SolidColorBrush x:Key="ResultLineBrush" Color="{StaticResource ResultLineColor}" />
            <SolidColorBrush x:Key="StatusChangedBrush" Color="{StaticResource StatusChangedColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#FF7B93FF</Color>
            <Color x:Key="TextPrimaryColor">#FFF2F3F5</Color>
            <Color x:Key="TextSecondaryColor">#FFA9AEB8</Color>
            <Color x:Key="TextTertiaryColor">#FF6B7280</Color>
            <Color x:Key="CardBackgroundColor">#B81E2128</Color>
            <Color x:Key="CardBorderColor">#1AFFFFFF</Color>
            <Color x:Key="TimelineRailColor">#FF3A3F4B</Color>
            <Color x:Key="CodenameChipBgColor">#2E7B93FF</Color>
            <Color x:Key="CodenameChipTextColor">#FFA9B8FF</Color>
            <Color x:Key="ResultLineColor">#FF3DDC97</Color>
            <Color x:Key="StatusChangedColor">#FFF0A050</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="TimelineRailBrush" Color="{StaticResource TimelineRailColor}" />
            <SolidColorBrush x:Key="CodenameChipBgBrush" Color="{StaticResource CodenameChipBgColor}" />
            <SolidColorBrush x:Key="CodenameChipTextBrush" Color="{StaticResource CodenameChipTextColor}" />
            <SolidColorBrush x:Key="ResultLineBrush" Color="{StaticResource ResultLineColor}" />
            <SolidColorBrush x:Key="StatusChangedBrush" Color="{StaticResource StatusChangedColor}" />
        </ResourceDictionary>

        <!-- "Default" mirrors Dark (used when no explicit theme dictionary matches). -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="AccentColor">#FF7B93FF</Color>
            <Color x:Key="TextPrimaryColor">#FFF2F3F5</Color>
            <Color x:Key="TextSecondaryColor">#FFA9AEB8</Color>
            <Color x:Key="TextTertiaryColor">#FF6B7280</Color>
            <Color x:Key="CardBackgroundColor">#B81E2128</Color>
            <Color x:Key="CardBorderColor">#1AFFFFFF</Color>
            <Color x:Key="TimelineRailColor">#FF3A3F4B</Color>
            <Color x:Key="CodenameChipBgColor">#2E7B93FF</Color>
            <Color x:Key="CodenameChipTextColor">#FFA9B8FF</Color>
            <Color x:Key="ResultLineColor">#FF3DDC97</Color>
            <Color x:Key="StatusChangedColor">#FFF0A050</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="TimelineRailBrush" Color="{StaticResource TimelineRailColor}" />
            <SolidColorBrush x:Key="CodenameChipBgBrush" Color="{StaticResource CodenameChipBgColor}" />
            <SolidColorBrush x:Key="CodenameChipTextBrush" Color="{StaticResource CodenameChipTextColor}" />
            <SolidColorBrush x:Key="ResultLineBrush" Color="{StaticResource ResultLineColor}" />
            <SolidColorBrush x:Key="StatusChangedBrush" Color="{StaticResource StatusChangedColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- color.kind (theme-invariant): node phase tag colors (PRD §3.3b), keyed 需求/任务/… in the JSON -->
    <Color x:Key="KindRequirementColor">#FF4F6BF0</Color>
    <Color x:Key="KindTaskColor">#FFE8833A</Color>
    <Color x:Key="KindResearchColor">#FF0FA9A0</Color>
    <Color x:Key="KindLearningColor">#FF9B59B6</Color>
    <Color x:Key="KindDecisionColor">#FFD94A4A</Color>
    <Color x:Key="KindFixColor">#FF0FA968</Color>
    <Color x:Key="KindOtherColor">#FF86909C</Color>
    <SolidColorBrush x:Key="KindRequirementBrush" Color="{StaticResource KindRequirementColor}" />
    <SolidColorBrush x:Key="KindTaskBrush" Color="{StaticResource KindTaskColor}" />
    <SolidColorBrush x:Key="KindResearchBrush" Color="{StaticResource KindResearchColor}" />
    <SolidColorBrush x:Key="KindLearningBrush" Color="{StaticResource KindLearningColor}" />
    <SolidColorBrush x:Key="KindDecisionBrush" Color="{StaticResource KindDecisionColor}" />
    <SolidColorBrush x:Key="KindFixBrush" Color="{StaticResource KindFixColor}" />
    <SolidColorBrush x:Key="KindOtherBrush" Color="{StaticResource KindOtherColor}" />

    <!-- agentBadge (theme-invariant) -->
    <Color x:Key="AgentClaudeColor">#FFD97757</Color>
    <Color x:Key="AgentCodexColor">#FF10A37F</Color>
    <Color x:Key="AgentKimiColor">#FF4F8BFF</Color>
    <Color x:Key="AgentZcodeColor">#FF9B59B6</Color>
    <SolidColorBrush x:Key="AgentClaudeBrush" Color="{StaticResource AgentClaudeColor}" />
    <SolidColorBrush x:Key="AgentCodexBrush" Color="{StaticResource AgentCodexColor}" />
    <SolidColorBrush x:Key="AgentKimiBrush" Color="{StaticResource AgentKimiColor}" />
    <SolidColorBrush x:Key="AgentZcodeBrush" Color="{StaticResource AgentZcodeColor}" />

    <!-- typography -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code</FontFamily>
    <x:Double x:Key="FontSizeTitle">13</x:Double>
    <x:Double x:Key="FontSizeBody">12</x:Double>
    <x:Double x:Key="FontSizeCaption">10.5</x:Double>
    <x:Double x:Key="FontSizeChip">10</x:Double>

    <!-- spacing -->
    <Thickness x:Key="PanelPadding">12</Thickness>
    <Thickness x:Key="CardPadding">10</Thickness>
    <x:Double x:Key="CardGap">8</x:Double>
    <x:Double x:Key="RailWidth">2</x:Double>
    <x:Double x:Key="RailDotSize">7</x:Double>
    <Thickness x:Key="ChipPadding">6,2</Thickness>

    <!-- radius -->
    <CornerRadius x:Key="PanelCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">5</CornerRadius>

</ResourceDictionary>
