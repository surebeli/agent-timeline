<Window
    x:Class="AgentTimeline.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:ui="using:AgentTimeline.UI">

    <!--
      Borderless translucent floating panel (PRD F5). Window chrome is configured in
      code-behind (AppWindow + OverlappedPresenter, DesktopAcrylicController backdrop,
      layered-window hover opacity). RootGrid carries the panelScrim (PRD §3.2b 自稳对比):
      a translucent base layered between the acrylic backdrop and all content, compressing
      whatever bleeds through (dark IDEs, bright pages) into a predictable base so the
      token palette always keeps its contrast. Window opacity behavior is unchanged.
    -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource PanelScrimBrush}"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">

        <Grid.Resources>
            <!-- token font for every text element in the panel -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════ System tray (H.NotifyIcon) ═══════════════ -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="SecondWindow"
            IconSource="ms-appx:///Assets/TrayIcon.ico"
            NoLeftClickDelay="True"
            ToolTipText="Agent Timeline">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout AreOpenCloseAnimationsEnabled="False">
                    <MenuFlyoutItem x:Name="TrayShowHideItem" Click="TrayShowHide_Click" Text="显示 / 隐藏" />
                    <ToggleMenuFlyoutItem x:Name="TrayAlwaysOnTopItem" Click="TrayAlwaysOnTop_Click" Text="总在最前" />
                    <MenuFlyoutItem Click="TraySettings_Click" Text="设置…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="TrayExit_Click" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- ═══════════════ Header (drag area + filter + actions) ═══════════════ -->
        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Padding="12,10,12,6"
            Background="Transparent"
            ColumnSpacing="8"
            PointerPressed="HeaderBar_PointerPressed">
            <Grid.ColumnDefinitions>
                <!-- 标题列 *（可省略）+ 过滤/按钮列 Auto：340px 宽装不下全量标题与
                     过滤器，空间紧张时标题省略号让位（M3 实机布局修正） -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ColumnSpacing="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Grid.Column="0"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource AccentBrush}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="{StaticResource FontSizeTitle}"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="Agent Timeline"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center">
                <!-- 过滤器用紧凑 Button + MenuFlyout（菜单项在 Opening 时从 VM 选项重建）：
                     标准 ComboBox 受主题最小宽(64px)约束、DropDownButton 的内建 chevron
                     区太宽，两者都塞不进 340px 头部（溢出压到标题，M3 实机发现）；
                     文字"▾"后缀的紧凑按钮即 mac 参照物的过滤器形态。 -->
                <Button
                    x:Name="ProjectFilterButton"
                    MaxWidth="110"
                    Padding="5,3,5,4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="项目过滤">
                    <TextBlock
                        x:Name="ProjectFilterLabel"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="全部 ▾"
                        TextTrimming="CharacterEllipsis" />
                    <Button.Flyout>
                        <MenuFlyout Opening="ProjectFilterFlyout_Opening" />
                    </Button.Flyout>
                </Button>
                <!-- Node kind filter (PRD §3.3b 阶段锚点): 阶段(全部) / 需求 / 任务 / … -->
                <Button
                    x:Name="KindFilterButton"
                    Padding="5,3,5,4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="阶段过滤">
                    <TextBlock
                        x:Name="KindFilterLabel"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="阶段 ▾" />
                    <Button.Flyout>
                        <MenuFlyout Opening="KindFilterFlyout_Opening" />
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
                <!-- Codename dictionary panel (PRD §3.3b 词典总览入口) -->
                <Button
                    x:Name="DictionaryButton"
                    Click="OpenDictionary_Click"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="代号词典">
                    <FontIcon FontSize="12" Glyph="&#xE82D;" />
                </Button>
                <Button
                    Click="OpenSettings_Click"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontSize="12" Glyph="&#xE713;" />
                </Button>
                <Button
                    Click="HidePanel_Click"
                    Style="{StaticResource HeaderIconButtonStyle}"
                    ToolTipService.ToolTip="收进托盘">
                    <FontIcon FontSize="12" Glyph="&#xE921;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════ Timeline: 双墨线台账 ledger (PRD §3.2b), newest on top ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.Resources>

                <!-- Day divider (今天 · n条 / 昨天 / MM-dd · ddd): opaque-ish backing,
                     6px tick crossing the rail, letter-spaced label, hairline rule. -->
                <DataTemplate x:Key="DayHeaderTemplate" x:DataType="ui:DayHeaderViewModel">
                    <Grid
                        Background="{ThemeResource DayHeaderBgBrush}"
                        ColumnSpacing="8"
                        Padding="0,5,12,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            Grid.Column="0"
                            Width="6"
                            Height="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DayHeaderRuleBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            CharacterSpacing="{StaticResource DayHeaderCharacterSpacing}"
                            FontSize="{StaticResource FontSizeDayHeader}"
                            FontWeight="Medium"
                            Foreground="{ThemeResource DayHeaderTextBrush}"
                            Text="{x:Bind Label}" />
                        <Rectangle
                            Grid.Column="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DayHeaderRuleBrush}" />
                    </Grid>
                </DataTemplate>

                <!-- Boxless ledger entry. Grammar: ❯ + solid agent rule + opaque paper
                     block = my literal words; ✦ + dotted rule = machine-derived. -->
                <DataTemplate x:Key="NodeTemplate" x:DataType="ui:NodeViewModel">
                    <Grid
                        Background="Transparent"
                        PointerEntered="Entry_PointerEntered"
                        PointerExited="Entry_PointerExited"
                        RightTapped="Entry_RightTapped">

                        <!-- 需求/决策 anchor wash: full-width kind color @8%, radius 6 -->
                        <Border
                            Background="{x:Bind AnchorWashBrush, Mode=OneWay}"
                            CornerRadius="{StaticResource AnchorWashCornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind HasAnchorWash, Mode=OneWay}" />
                        <!-- hover layer -->
                        <Border
                            x:Name="HoverLayer"
                            Background="{ThemeResource EntryHoverBrush}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind IsHovering, Mode=OneWay}" />
                        <!-- expand hit layer: catches taps on the entry background / meta row;
                             selectable text and buttons sit ABOVE it, so text selection wins -->
                        <Border Background="Transparent" Tapped="EntryBackground_Tapped" />

                        <!-- rail gutter: continuous 2px segment (joins across entries) + kind marker -->
                        <Grid
                            Width="22"
                            HorizontalAlignment="Left"
                            IsHitTestVisible="False">
                            <Rectangle
                                Width="{StaticResource RailWidth}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Fill="{ThemeResource TimelineRailBrush}" />
                            <Grid
                                Width="{StaticResource MarkerRingSize}"
                                Height="{StaticResource MarkerRingSize}"
                                Margin="0,30,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                                <!-- 需求/决策: filled kind-color diamond (rotated rect) -->
                                <Rectangle
                                    Width="{StaticResource MarkerAnchorSide}"
                                    Height="{StaticResource MarkerAnchorSide}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind MarkerBrush, Mode=OneWay}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="{x:Bind ShowAnchorMarker, Mode=OneWay}">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <!-- 任务/修复/调研/学习: filled 7px dot -->
                                <Ellipse
                                    Width="{StaticResource MarkerStandardSize}"
                                    Height="{StaticResource MarkerStandardSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind MarkerBrush, Mode=OneWay}"
                                    Visibility="{x:Bind ShowStandardMarker, Mode=OneWay}" />
                                <!-- 其他/未归类: hollow 5px circle -->
                                <Ellipse
                                    Width="{StaticResource MarkerMinorSize}"
                                    Height="{StaticResource MarkerMinorSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource DayHeaderBgBrush}"
                                    Stroke="{ThemeResource TimelineRailBrush}"
                                    StrokeThickness="1"
                                    Visibility="{x:Bind ShowMinorMarker, Mode=OneWay}" />
                                <!-- codename-defining node: accent ring -->
                                <Ellipse
                                    Width="{StaticResource MarkerRingSize}"
                                    Height="{StaticResource MarkerRingSize}"
                                    Stroke="{ThemeResource AccentBrush}"
                                    StrokeThickness="{StaticResource MarkerRingWidth}"
                                    Visibility="{x:Bind IsDefinitionNode, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <!-- entry content, inset past the rail gutter -->
                        <Grid Margin="22,9,12,9" RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- meta row: time · project · agent · kind tag, rotating chevron;
                                 the row itself is an expand hit zone (text here not selectable) -->
                            <Grid
                                Grid.Row="0"
                                Background="Transparent"
                                ColumnSpacing="6"
                                Tapped="EntryBackground_Tapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="{x:Bind TimeText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="{x:Bind Project}"
                                    TextTrimming="CharacterEllipsis" />
                                <!-- 来源标注：agent 色圆角块 + 双字母缩写 icon + 名称
                                     （实机反馈：多 agent 混排时需一眼分辨来源） -->
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind AgentBrush}"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="{x:Bind AgentName}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="7"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{x:Bind AgentMonogram}" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeChip}"
                                        FontWeight="Medium"
                                        Foreground="{x:Bind AgentBrush}"
                                        Text="{x:Bind AgentName}" />
                                </StackPanel>
                                <!-- node kind tag (PRD §3.3b), colors from color.kind tokens -->
                                <Border
                                    Grid.Column="3"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind KindBgBrush, Mode=OneWay}"
                                    CornerRadius="3"
                                    Visibility="{x:Bind HasKind, Mode=OneWay}">
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeChip}"
                                        FontWeight="Medium"
                                        Foreground="{x:Bind KindBrush, Mode=OneWay}"
                                        Text="{x:Bind Kind, Mode=OneWay}" />
                                </Border>
                                <Button
                                    Grid.Column="4"
                                    Width="24"
                                    Height="24"
                                    Click="ExpandNode_Click"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    ToolTipService.ToolTip="展开 / 收起">
                                    <FontIcon
                                        FontSize="9"
                                        Glyph="&#xE70D;"
                                        RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="{x:Bind ChevronAngle, Mode=OneWay}" />
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                </Button>
                            </Grid>

                            <!-- COMMAND BLOCK hero: raw words always visible on an opaque paper
                                 block; flattened top-left corner points at the rail marker -->
                            <Grid Grid.Row="1">
                                <Border
                                    Background="{ThemeResource CommandBgBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CommandBlockCornerRadius}"
                                    Padding="{StaticResource CommandPadding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="{StaticResource FontSizeCommand}"
                                            Foreground="{x:Bind AgentBrush}"
                                            Text="❯" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="{StaticResource AppFontFamily}"
                                            FontSize="{StaticResource FontSizeCommand}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CommandTextBrush}"
                                            IsTextSelectionEnabled="True"
                                            MaxLines="{x:Bind CommandMaxLines, Mode=OneWay}"
                                            Text="{x:Bind PromptText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <!-- 2px solid agent-colored quote rule flush on the leading edge;
                                     drawn AFTER the paper block so it sits over the 1px
                                     surfaceStroke there (mac overlay order: fill → stroke → rule) -->
                                <Border
                                    Width="{StaticResource QuoteRuleWidth}"
                                    HorizontalAlignment="Left"
                                    Background="{x:Bind AgentBrush}"
                                    CornerRadius="{StaticResource CommandRuleCornerRadius}"
                                    IsHitTestVisible="False" />
                                <!-- hover copy button; glyph morphs to ✓ (resultLine green) for 800ms -->
                                <Button
                                    x:Name="EntryCopyButton"
                                    Margin="0,2,2,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Click="CopyCommand_Click"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    ToolTipService.ToolTip="复制原话"
                                    Visibility="{x:Bind ShowCopyButton, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{x:Bind CopyBrush, Mode=OneWay}"
                                        Glyph="{x:Bind CopyGlyph, Mode=OneWay}" />
                                </Button>
                            </Grid>

                            <!-- DERIVED BLOCK: everything machine-generated on its own
                                 secondary paper (derivedBg, plain radius 8) so it never
                                 sinks into the wallpaper bleeding through the translucent
                                 panel; 14px leading indent OUTSIDE the backing, the 1px
                                 dotted rule inside it -->
                            <Border
                                Grid.Row="2"
                                Margin="{StaticResource DerivedIndent}"
                                Background="{ThemeResource DerivedBgBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource DerivedBlockCornerRadius}"
                                Padding="{StaticResource CommandPadding}"
                                Visibility="{x:Bind HasDerived, Mode=OneWay}">
                              <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Line
                                    Grid.Column="0"
                                    Width="{StaticResource DerivedRuleWidth}"
                                    VerticalAlignment="Stretch"
                                    Stretch="Fill"
                                    Stroke="{ThemeResource DerivedRuleBrush}"
                                    StrokeDashArray="2,3"
                                    StrokeThickness="{StaticResource DerivedRuleWidth}"
                                    X1="0.5"
                                    X2="0.5"
                                    Y1="0"
                                    Y2="1" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <!-- ✦ + demoted LLM title (suppressed for short/echo commands) -->
                                    <Grid ColumnSpacing="4" Visibility="{x:Bind HasDerivedTitle, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="{StaticResource FontSizeChip}"
                                            Foreground="{ThemeResource TextTertiaryBrush}"
                                            Text="✦" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="{StaticResource FontSizeDerivedTitle}"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            MaxLines="1"
                                            Text="{x:Bind DerivedTitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <!-- collapsed: one-line keypoints digest + accent "+n" -->
                                    <Grid ColumnSpacing="4" Visibility="{x:Bind ShowKeypointsDigest, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind KeypointsDigest, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeChip}"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource AccentBrush}"
                                            Text="{x:Bind KeypointsOverflow, Mode=OneWay}"
                                            Visibility="{x:Bind HasKeypointsOverflow, Mode=OneWay}" />
                                    </Grid>
                                    <!-- expanded: full bullet list -->
                                    <ItemsControl ItemsSource="{x:Bind KeyPoints, Mode=OneWay}" Visibility="{x:Bind ShowKeypointsList, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource AccentBrush}"
                                                        Text="·" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- codename chips: 4px hit inflate (padding grows the hit
                                         box, negative margin keeps layout), status badge live -->
                                    <ItemsControl ItemsSource="{x:Bind Codenames, Mode=OneWay}" Visibility="{x:Bind HasCodenames, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ui:CodenameChipViewModel">
                                                <Button
                                                    Margin="-4"
                                                    Padding="4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="CodenameChip_Click"
                                                    MinHeight="0"
                                                    MinWidth="0">
                                                    <Border
                                                        Background="{ThemeResource CodenameChipBgBrush}"
                                                        CornerRadius="{StaticResource ChipCornerRadius}"
                                                        Padding="{StaticResource ChipPadding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeChip}"
                                                                FontWeight="Medium"
                                                                Foreground="{ThemeResource CodenameChipTextBrush}"
                                                                Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                FontSize="{StaticResource FontSizeChip}"
                                                                FontWeight="Bold"
                                                                Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                                                Text="{x:Bind StatusGlyph, Mode=OneWay}"
                                                                Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- green result line, last -->
                                    <TextBlock
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{ThemeResource ResultLineBrush}"
                                        IsTextSelectionEnabled="True"
                                        MaxLines="{x:Bind ResultLineMaxLines, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasResultLine, Mode=OneWay}">
                                        <Run Text="→ " /><Run Text="{x:Bind ResultLine, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                              </Grid>
                            </Border>
                        </Grid>

                        <!-- 1px hairline divider, inset past the rail gutter -->
                        <Rectangle
                            Height="1"
                            Margin="{StaticResource EntryDividerInset}"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource EntryDividerBrush}"
                            IsHitTestVisible="False" />
                    </Grid>
                </DataTemplate>
            </Grid.Resources>

            <ScrollViewer
                x:Name="TimelineScroller"
                Padding="12,0,12,0"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="TimelineScroller_ViewChanged">
                <ItemsRepeater x:Name="NodeRepeater" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <ui:TimelineItemTemplateSelector DayHeaderTemplate="{StaticResource DayHeaderTemplate}" NodeTemplate="{StaticResource NodeTemplate}" />
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- sticky (pinned) day header: mirrors the in-flow divider for the day
                 currently scrolled past the top; updated from ViewChanged -->
            <Grid
                x:Name="StickyDayHeader"
                Margin="12,0,12,0"
                VerticalAlignment="Top"
                Background="{ThemeResource DayHeaderBgBrush}"
                ColumnSpacing="8"
                IsHitTestVisible="False"
                Padding="0,5,12,5"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle
                    Grid.Column="0"
                    Width="6"
                    Height="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DayHeaderRuleBrush}" />
                <TextBlock
                    x:Name="StickyDayLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    CharacterSpacing="{StaticResource DayHeaderCharacterSpacing}"
                    FontSize="{StaticResource FontSizeDayHeader}"
                    FontWeight="Medium"
                    Foreground="{ThemeResource DayHeaderTextBrush}" />
                <Rectangle
                    Grid.Column="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DayHeaderRuleBrush}" />
            </Grid>
        </Grid>

        <!-- ═══════════════ Footer: lazy loading ═══════════════ -->
        <Button
            Grid.Row="2"
            Margin="12,6,12,10"
            HorizontalAlignment="Stretch"
            Click="LoadMore_Click"
            Content="加载更多"
            FontSize="{StaticResource FontSizeBody}"
            Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
    </Grid>
</Window>
